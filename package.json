{
    "name": "obsidian-typing-transformer",
    "version": "0.4.9",
    "description": "Improved, configurable auto formatting as typing",
    "main": "src/main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:coverage:open": "vitest --coverage --run && xdg-open coverage/index.html || open coverage/index.html || powershell.exe -c \"Start-Process coverage/index.html\" || start coverage/index.html",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@codemirror/commands": "6.11.1",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/state": "6.7.6",
        "@codemirror/view": "6.43.13",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "@vitest/coverage-v8": "^5.1.0",
        "@vitest/ui": "^5.1.0",
        "builtin-modules": "5.5.0",
        "codemirror": "^6.0.2",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "obsidian": "1.14.4",
        "tslib": "2.9.1",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
    },
    "overrides": {
        "@codemirror/state": "$@codemirror/state",
        "@codemirror/view": "$@codemirror/view"
    },
    "engines": {
        "node": ">=26.0.0 <27"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true
    }
}
